# Copy to app/.env. Docker Compose and local dev (`uv run chat-api`) both read it.
# Only OPENAI_API_KEY is required; everything else has a working default.

# --- Model provider -------------------------------------------------------------
OPENAI_API_KEY=
# openai (default) or openrouter. For OpenRouter, also set OPENROUTER_API_KEY.
# APP_CHAT_PROVIDER=openai
# OPENROUTER_API_KEY=

# --- Models ---------------------------------------------------------------------
# The chat agent. Default gpt-5.4 (openrouter: openai/gpt-5.4)
# APP_CHAT_MODEL=
# The router and the rationale writer. Default gpt-5.4-mini (openrouter: openai/gpt-5.4-mini)
# APP_WORKFLOW_MODEL=

# --- Selection rules (README.md, "Selection rules") -----------------------------
# A mode name or JSON, e.g. {"headroom": 0.1} or {"max_lines": 3}
# APP_INVENTORY_POLICY=adjusted
# APP_SELECTION_POLICY=single_first

# --- Optional -------------------------------------------------------------------
# Enables the web_search tool (Linkup)
# LINKUP_API_KEY=
# Langfuse tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# Seed the example chats for each new user (the Docker image sets 1)
# APP_EXAMPLE_CHATS=1
# Host port for the UI (Docker)
# WEB_PORT=8080
